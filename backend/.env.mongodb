# ====================================
# ALEM CRM BACKEND - MongoDB Configuration
# ====================================
# Copy this to .env and add your MongoDB URL

# ====== MONGODB CONFIGURATION ======
MONGODB_URI=your_mongodb_connection_url_here
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/alem_crm?retryWrites=true&w=majority

# Database name
DB_NAME=alem_crm

# ====== JWT CONFIGURATION ======
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_required_here_12345
JWT_EXPIRES_IN=24h

# ====== APPLICATION ======
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ====== CORS ======
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# ====== EMAIL (Optional) ======
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM=noreply@alemtrading.com
MAIL_FROM_NAME=ALEM Trading

# ====== REDIS (Optional - for caching) ======
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ====== FILE UPLOAD ======
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ====== RATE LIMITING ======
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ====== LOGGING ======
LOG_LEVEL=info
LOG_FORMAT=json

# ====== SESSION ======
SESSION_SECRET=your_session_secret_min_32_chars_here_1234567890
SESSION_EXPIRES_IN=7d

# ====== FEATURE FLAGS ======
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_PAYMENT_GATEWAY=false
ENABLE_AUDIT_LOGS=true
