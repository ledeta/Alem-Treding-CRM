# ============================================================================
# Render Production Environment Variables Template
# ============================================================================
# 
# Instructions:
# 1. DO NOT commit this file with actual values to git
# 2. Copy these variables into Render's Environment Variables panel
# 3. Replace placeholder values with actual production values
# 4. Keep JWT_SECRET and DATABASE_URL secure - never share them
#
# How to add in Render:
# 1. Go to your backend service in Render dashboard
# 2. Click "Environment" in left sidebar
# 3. Add each variable below as a new environment variable
# 4. Click "Save Changes" - service will automatically redeploy
# ============================================================================

# ============================================================================
# REQUIRED VARIABLES - Must be set before deployment
# ============================================================================

# Environment flag - tells the app it's running in production
NODE_ENV=production

# Server port - Render assigns this automatically, but default is 10000
PORT=10000

# Database connection string - CRITICAL: Use Internal Database URL from Render
# Get this from: Render Dashboard → Your PostgreSQL service → Connections → Internal Database URL
# Format: postgresql://user:password@host:5432/database_name
DATABASE_URL=<paste Internal Database URL from Render PostgreSQL service>

# JWT secret for signing authentication tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# IMPORTANT: Must be at least 32 characters, keep this secret and secure
JWT_SECRET=<generate using command above>

# JWT token expiration time
# Examples: 24h (24 hours), 7d (7 days), 30d (30 days)
JWT_EXPIRES_IN=24h

# Frontend URL - your Next.js frontend service URL on Render
# Format: https://your-frontend-service-name.onrender.com
# NO trailing slash!
FRONTEND_URL=https://<your-frontend>.onrender.com

# CORS allowed origin - should match FRONTEND_URL exactly
# This controls which domains can make API requests to your backend
CORS_ORIGIN=https://<your-frontend>.onrender.com

# Enable credentials (cookies, auth headers) in CORS requests
CORS_CREDENTIALS=true

# Auto-create database tables on first deployment
# IMPORTANT: Set to "false" after first successful deployment to prevent data loss
DB_SYNCHRONIZE=true

# ============================================================================
# RECOMMENDED VARIABLES - Good defaults provided
# ============================================================================

# Logging level: error, warn, info, debug
# info is good for production - shows important messages without too much noise
LOG_LEVEL=info

# Maximum file upload size in bytes
# 10485760 = 10 MB
MAX_FILE_SIZE=10485760

# ============================================================================
# OPTIONAL VARIABLES - Only needed for specific features
# ============================================================================

# Email Configuration (for notifications)
# Uncomment and fill if you need email functionality
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USER=your-email@example.com
# MAIL_PASS=your-email-password
# MAIL_FROM=noreply@yourcompany.com

# Rate Limiting
# Maximum requests per minute per IP address
# RATE_LIMIT_MAX_REQUESTS=100

# Session Secret (if using session-based auth instead of JWT)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=<generate if needed>

# Redis Cache (for improved performance)
# Get Redis URL from Render Redis service or external provider
# REDIS_URL=redis://user:password@host:6379

# Sentry Error Tracking (recommended for production monitoring)
# Get DSN from: https://sentry.io → Your Project → Settings → Client Keys
# SENTRY_DSN=https://examplePublicKey@sentry.io/project-id

# AWS S3 File Storage (if using file uploads to S3)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1

# Feature Flags
# ENABLE_EMAIL_NOTIFICATIONS=true
# ENABLE_AUDIT_LOGS=true
# ENABLE_TWO_FACTOR_AUTH=false

# Database Configuration (advanced)
# DB_LOGGING=false
# DB_CONNECTION_TIMEOUT=30000
# DB_MAX_CONNECTIONS=20

# ============================================================================
# POST-DEPLOYMENT CHECKLIST
# ============================================================================
# 
# After your first successful deployment:
# 
# [ ] 1. Change DB_SYNCHRONIZE from "true" to "false"
#        - This prevents automatic schema changes in production
#        - Use migrations for schema updates instead
# 
# [ ] 2. Verify JWT_SECRET is at least 32 characters
#        - Check that authentication works
#        - Test login with admin and sales users
# 
# [ ] 3. Confirm CORS_ORIGIN matches your frontend URL exactly
#        - No trailing slash
#        - Must use https://
#        - Test from frontend that API calls work
# 
# [ ] 4. Test the health endpoint
#        - Visit: https://your-backend.onrender.com/api/health
#        - Should return: {"status":"ok",...}
# 
# [ ] 5. Review logs for any errors or warnings
#        - Render Dashboard → Your Backend Service → Logs
#        - Look for database connection, CORS, or authentication errors
# 
# [ ] 6. Set up regular database backups
#        - Render provides automatic backups on paid plans
#        - Verify backup schedule in database settings
# 
# [ ] 7. Consider adding monitoring
#        - Add SENTRY_DSN for error tracking
#        - Set up external uptime monitoring
# 
# [ ] 8. Change default user passwords
#        - Default admin: admin@alemtrading.com / admin123
#        - Default sales: sales@alemtrading.com / sales123
#        - Update through the admin interface after first login
# 
# ============================================================================
# SECURITY BEST PRACTICES
# ============================================================================
# 
# - Never commit .env files with real values to git
# - Rotate JWT_SECRET periodically (every 90 days recommended)
# - Use strong, unique passwords for database users
# - Enable 2FA for admin accounts in production
# - Keep dependencies updated (run npm audit)
# - Review logs regularly for suspicious activity
# - Set up rate limiting to prevent abuse
# - Use HTTPS only (Render provides this automatically)
# - Restrict CORS_ORIGIN to your specific domain (no wildcards)
# 
# ============================================================================
