# ============================================
# ALEM CRM - RENDER DEPLOYMENT ENV TEMPLATE
# ============================================
# Copy this file to configure environment variables for Render.com
# This is a production-ready template - update values as needed

# ============================================
# DATABASE (Render PostgreSQL)
# ============================================
DB_HOST=your-postgres-database-host.onrender.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here_change_this
DB_NAME=alem_crm

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=3001
API_URL=https://api.your-domain.com
FRONTEND_URL=https://your-domain.com

# ============================================
# JWT AUTHENTICATION (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# ============================================
JWT_SECRET=replace_with_random_32_char_string_from_command_above
JWT_EXPIRATION=3600
JWT_REFRESH_SECRET=replace_with_another_random_32_char_string
JWT_REFRESH_EXPIRATION=604800

# ============================================
# REDIS (Optional - Render Redis)
# ============================================
REDIS_HOST=your-redis-host.onrender.com
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here_or_leave_empty

# ============================================
# EMAIL SERVICE (Gmail or SendGrid)
# ============================================
# OPTION A: Gmail (Recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password-from-google
SMTP_SECURE=false
SMTP_FROM=ALEM TRADING <noreply@alem-trading.com>
SMTP_FROM_NAME=ALEM TRADING Management System
EMAIL_SERVICE=gmail

# OPTION B: SendGrid (Uncomment to use instead of Gmail)
# SENDGRID_API_KEY=your-sendgrid-api-key-here

# ============================================
# FILE UPLOAD
# ============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=xlsx,xls

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT=100
RATE_LIMIT_WINDOW=60

# ============================================
# SECURITY
# ============================================
ENABLE_HELMET=true
ENABLE_CSRF=true
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ============================================
# AWS S3 (Optional - for file storage)
# ============================================
# AWS_ACCESS_KEY_ID=your-aws-access-key-here
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key-here
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=alem-crm-uploads-prod

# ============================================
# BACKUP CONFIGURATION
# ============================================
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# ============================================
# MONITORING (Optional - Sentry for error tracking)
# ============================================
# SENTRY_DSN=your-sentry-project-dsn-here
# SENTRY_ENVIRONMENT=production

# ============================================
# FRONTEND CONFIGURATION
# ============================================
NEXT_PUBLIC_API_URL=https://api.your-domain.com
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=replace_with_random_32_char_string_different_from_jwt_secret

# Optional: Analytics
# NEXT_PUBLIC_ANALYTICS_ID=your-google-analytics-id

# ============================================
# INSTRUCTIONS
# ============================================
# 1. Replace all "your_*" placeholders with actual values
# 2. Generate JWT secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. For Gmail: Generate app password at https://myaccount.google.com/apppasswords
# 4. Keep this file secure - never commit to version control
# 5. Add variables to Render dashboard under: Settings > Environment
# 6. Restart service after updating environment variables
