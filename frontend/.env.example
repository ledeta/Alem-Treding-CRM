# ====================================
# ALEM CRM FRONTEND - Environment Variables
# ====================================
# Copy this file to .env.local and fill in the values

# ====== API CONFIGURATION ======
NEXT_PUBLIC_API_URL=https://alem-crm-backend.onrender.com
NEXT_PUBLIC_API_TIMEOUT=30000

# ====== APPLICATION ======
NEXT_PUBLIC_APP_NAME=ALEM Trading CRM
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_URL=https://alem-crm-frontend.onrender.com

# ====== ENVIRONMENT ======
NODE_ENV=production

# ====== FEATURES ======
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_PAYMENT_GATEWAY=false
NEXT_PUBLIC_ENABLE_EXPORT_TO_PDF=true
NEXT_PUBLIC_ENABLE_EXPORT_TO_EXCEL=true

# ====== THIRD-PARTY INTEGRATIONS ======
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ====== UI CONFIGURATION ======
NEXT_PUBLIC_THEME=light
NEXT_PUBLIC_ITEMS_PER_PAGE=10
NEXT_PUBLIC_CURRENCY_SYMBOL=ETB
NEXT_PUBLIC_DATE_FORMAT=MM/dd/yyyy
NEXT_PUBLIC_DECIMAL_PLACES=2

# ====== TIMEOUT CONFIGURATIONS (milliseconds) ======
NEXT_PUBLIC_REQUEST_TIMEOUT=30000
NEXT_PUBLIC_CACHE_DURATION=600000
NEXT_PUBLIC_SESSION_TIMEOUT=3600000

# ====== FEATURE FLAGS ======
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_BETA_FEATURES_ENABLED=false
NEXT_PUBLIC_DEBUG_MODE=false
