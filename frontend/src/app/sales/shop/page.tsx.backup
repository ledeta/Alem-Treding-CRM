            <div style={{
              padding: '2rem',
              borderTop: '1px solid #e2e8f0',
              background: '#f8fafc',
              display: 'grid',
              gridTemplateColumns: '1fr 1fr',
              gap: '1rem',
            }}>
              <button
                onClick={() => setShowPayModal(false)}
                style={{
                  padding: '1rem',
                  background: '#f1f5f9',
                  color: '#64748b',
                  border: '1px solid #e2e8f0',
                  borderRadius: '12px',
                  fontWeight: '700',
                  fontSize: '0.9rem',
                  cursor: 'pointer',
                  transition: 'all 0.2s ease',
                  textTransform: 'uppercase',
                  letterSpacing: '0.05em',
                }}
                onMouseEnter={(e) => {
                  e.currentTarget.style.background = '#e2e8f0'
                }}
                onMouseLeave={(e) => {
                  e.currentTarget.style.background = '#f1f5f9'
                }}
              >
                Cancel
              </button>
              <button
                onClick={() => {
                  if (paymentAmount && paymentReference && selectedCustomer) {
                    const mainAmount = parseFloat(paymentAmount)
                    const additionalBankTotal = additionalBanks.reduce((sum, bank) => sum + (parseFloat(bank.amount) || 0), 0)
                    const additionalAmount = parseFloat(additionalPayment) || 0
                    const totalPayment = mainAmount + additionalBankTotal + additionalAmount

                    // Create main payment transaction
                    const paymentTransaction = {
                      id: Date.now(),
                      type: 'Payment',
                      transactionType: 'Payment',
                      customerName: selectedCustomer,
                      customer: selectedCustomer,
                      amount: paymentAmount,
                      bank: selectedBank,
                      reason: paymentNotes,
                      transactionId: paymentReference,
                      status: 'Pending',
                      date: new Date().toISOString(),
                      approvalStatus: 'pending',
                      requestedBy: localStorage.getItem('user_email') || 'sales',
                      requestedAt: new Date().toISOString(),
                    }

                    // Save transaction
                    const existing = JSON.parse(localStorage.getItem('confirmed_transactions') || '[]')
                    const updated = [...existing, paymentTransaction]
                    
                    // Add additional bank payments
                    additionalBanks.forEach(bank => {
                      if (bank.amount && bank.reason) {
                        updated.push({
                          id: Date.now() + Math.random(),
                          type: 'Payment',
                          transactionType: 'Payment',
                          customerName: selectedCustomer,
                          customer: selectedCustomer,
                          amount: bank.amount,
                          bank: bank.bank,
                          reason: bank.reason,
                          transactionId: bank.reason,
                          status: 'Pending',
                          date: new Date().toISOString(),
                          approvalStatus: 'pending',
                          requestedBy: localStorage.getItem('user_email') || 'sales',
                          requestedAt: new Date().toISOString(),
                        })
                      }
                    })

                    localStorage.setItem('confirmed_transactions', JSON.stringify(updated))

                    alert(`✅ Payment Request Submitted!\n\n👤 Customer: ${selectedCustomer}\n💰 Total: ${totalPayment.toLocaleString('en-US', { minimumFractionDigits: 2 })} ብር\n🏦 Bank: ${selectedBank}\n🔢 Transaction ID: ${paymentReference}\n\n⏳ Status: PENDING APPROVAL`)

                    setShowPayModal(false)
                    setPaymentAmount('')
                    setSelectedBank('CBE')
                    setPaymentReference('')
                    setAdditionalPayment('')
                    setAdditionalBanks([])
                    setPaymentNotes('')
                  } else {
                    alert('⚠️ Please fill in all required fields:\n• Amount\n• Transaction ID')
                  }
                }}
                style={{
                  padding: '1rem',
                  background: 'linear-gradient(135deg, #10b981 0%, #059669 100%)',
                  color: 'white',
                  border: 'none',
                  borderRadius: '12px',
                  fontWeight: '700',
                  fontSize: '0.9rem',
                  cursor: 'pointer',
                  transition: 'all 0.2s ease',
                  textTransform: 'uppercase',
                  letterSpacing: '0.05em',
                }}
                onMouseEnter={(e) => {
                  e.currentTarget.style.transform = 'translateY(-2px)'
                  e.currentTarget.style.boxShadow = '0 8px 16px rgba(16, 185, 129, 0.3)'
                }}
                onMouseLeave={(e) => {
                  e.currentTarget.style.transform = 'translateY(0)'
                  e.currentTarget.style.boxShadow = 'none'
                }}
              >
                Confirm Payment
              </button>
            </div>
          </div>
        </div>
      )}

