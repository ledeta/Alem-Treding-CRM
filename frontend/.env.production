# Production Environment Variables
# For Render.com Deployment

# Node environment - MUST be production for optimal performance
NODE_ENV=production

# API URL - Update this when you have the actual Render domain
# Format: https://[your-app-name].onrender.com
# This will be overridden by Render environment variables if set
NEXT_PUBLIC_API_URL=https://alem-crm-frontend.onrender.com

# Disable console logs in production (security best practice)
# Already disabled in next.config.js

# Enable React strict mode for production (catches potential bugs)
# Already enabled in next.config.js

# Note: This file should be committed to Git
# Sensitive data should NOT be stored here - use Render Dashboard for secrets
